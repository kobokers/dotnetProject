@{
    ViewData["Title"] = "Create Post";
}

<div class="feed-header">
    <h1 class="feed-title">Create Post</h1>
</div>

<div class="card">
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            @if (ViewData.ModelState.ErrorCount > 0)
            {
                <div class="auth-error mb-4">
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@err.ErrorMessage</div>
                    }
                </div>
            }
            <div class="form-group">
                <label class="form-label">What's on your mind?</label>
                <textarea name="content" class="form-input" rows="5" placeholder="Share something..." required></textarea>
            </div>
            <div class="form-group">
                <label class="form-label">Image <span style="color:var(--text-muted);font-weight:400;">(optional)</span></label>
                <div class="file-upload-wrapper">
                    <label class="file-upload-btn">
                        <i class="bi bi-image"></i> Choose Image
                        <input name="image" type="file" accept="image/*" hidden onchange="this.closest('.file-upload-wrapper').querySelector('.file-upload-name').textContent = this.files[0]?.name || 'No file chosen'" />
                    </label>
                    <span class="file-upload-name">No file chosen</span>
                </div>
            </div>
            <div class="flex gap-2">
                <button type="submit" class="btn btn-primary flex-1"><i class="bi bi-send"></i> Share</button>
                <a asp-action="Index" class="btn btn-outline flex-1">Cancel</a>
            </div>
        </form>
    </div>
</div>
