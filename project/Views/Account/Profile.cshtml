@model ApplicationUser
@inject ApplicationDbContext AppDbContext
@using Microsoft.EntityFrameworkCore
@{
    ViewData["Title"] = Model.DisplayName ?? Model.UserName;
    var postCount = await AppDbContext.Posts.CountAsync(p => p.UserId == Model.Id);
    var friendCount = await AppDbContext.FriendRequests.CountAsync(f =>
        f.Status == FriendRequestStatus.Accepted &&
        (f.SenderId == Model.Id || f.ReceiverId == Model.Id));
    var posts = await AppDbContext.Posts
        .Where(p => p.UserId == Model.Id)
        .OrderByDescending(p => p.CreatedAt)
        .Take(9)
        .ToListAsync();

    var isOwnProfile = false;
    if (User.Identity?.IsAuthenticated == true)
    {
        var currentUser = await UserManager.GetUserAsync(User);
        isOwnProfile = currentUser?.Id == Model.Id;
    }
}

<div id="profileSkeleton">
    <div class="profile-card">
        <div class="skeleton" style="height:200px;border-radius:var(--radius-xl) var(--radius-xl) 0 0;"></div>
        <div style="padding:12px 24px 24px;">
            <div class="skeleton" style="width:92px;height:92px;border-radius:50%;margin-top:-60px;margin-bottom:16px;border:4px solid var(--bg-primary);"></div>
            <div class="skeleton" style="width:180px;height:24px;margin-bottom:8px;"></div>
            <div class="skeleton" style="width:120px;height:14px;margin-bottom:16px;"></div>
            <div class="flex gap-4" style="margin-bottom:16px;">
                <div class="skeleton" style="width:60px;height:32px;"></div>
                <div class="skeleton" style="width:60px;height:32px;"></div>
            </div>
            <div class="skeleton" style="width:100%;height:14px;margin-bottom:6px;"></div>
            <div class="skeleton" style="width:70%;height:14px;margin-bottom:12px;"></div>
            <div class="skeleton" style="width:120px;height:36px;border-radius:8px;"></div>
        </div>
    </div>
    <div class="profile-posts-grid" style="margin-top:24px;">
        <div class="skeleton" style="aspect-ratio:1;border-radius:0;"></div>
        <div class="skeleton" style="aspect-ratio:1;border-radius:0;"></div>
        <div class="skeleton" style="aspect-ratio:1;border-radius:0;"></div>
    </div>
</div>

<div id="profileContent" style="display:none;">
<div class="profile-card">
    @if (!string.IsNullOrEmpty(Model.CoverPhoto))
    {
        <div class="profile-banner" style="background-image: url('/uploads/profiles/@Model.CoverPhoto'); background-size: cover; background-position: center;"></div>
    }
    else
    {
        <div class="profile-banner"></div>
    }
    <div class="profile-avatar-wrapper">
        @if (!string.IsNullOrEmpty(Model.ProfilePhoto))
        {
            <img src="@Model.ProfilePhoto" alt="" class="avatar avatar-xl" />
        }
        else
        {
            <div class="avatar-circle avatar-xl" style="font-size:56px;">@(Model.DisplayName?[0] ?? '?')</div>
        }
    </div>
    <div class="profile-info">
        <h1 class="profile-name">@Model.DisplayName</h1>
        <div class="profile-username">@@@Model.UserName</div>
        <div class="profile-stats">
            <div class="profile-stat">
                <span class="profile-stat-value">@postCount</span>
                <span class="profile-stat-label">Posts</span>
            </div>
            <div class="profile-stat">
                <span class="profile-stat-value">@friendCount</span>
                <span class="profile-stat-label">Friends</span>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Bio))
        {
            <div class="profile-bio">@Model.Bio</div>
        }
        @if (!string.IsNullOrEmpty(Model.Location))
        {
            <div class="profile-location"><i class="bi bi-geo-alt"></i> @Model.Location</div>
        }
        @if (Model.CreatedAt != default)
        {
            <div class="profile-joined"><i class="bi bi-calendar3"></i> Joined @Model.CreatedAt.ToLocalTime().ToString("MMMM yyyy")</div>
        }
        @if (isOwnProfile)
        {
            <a asp-action="Edit" class="btn btn-primary">Edit Profile</a>
        }
    </div>
</div>

@if (posts.Any())
{
    <div class="profile-posts-grid">
        @foreach (var post in posts)
        {
            <a asp-controller="Post" asp-action="Details" asp-route-id="@post.PostId" class="profile-post-item">
                @if (!string.IsNullOrEmpty(post.ImageUrl))
                {
                    <img src="@post.ImageUrl" alt="Post" class="profile-post-thumb" />
                }
                else
                {
                    <div class="profile-post-thumb-placeholder">
                        <i class="bi bi-file-text" style="font-size:24px;"></i>
                    </div>
                }
                <div class="profile-post-overlay">
                    <span><i class="bi bi-heart-fill"></i> @post.Likes?.Count</span>
                    <span><i class="bi bi-chat-fill"></i> @post.Comments?.Count</span>
                </div>
            </a>
        }
    </div>
}
else
{
    <div class="card-empty">
        <i class="bi bi-camera"></i>
        <p>No posts yet</p>
    </div>
}

</div>

@inject UserManager<ApplicationUser> UserManager

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var skeleton = document.getElementById('profileSkeleton');
        var content = document.getElementById('profileContent');
        if (skeleton && content) {
            skeleton.style.display = 'block';
            content.style.display = 'none';
            setTimeout(function() {
                skeleton.style.display = 'none';
                content.style.display = 'block';
            }, 600);
        }
    });
</script>
