@{ Layout = "_AuthLayout"; ViewData["Title"] = "Login"; }

<div class="auth-card">
    <div class="auth-logo">MehKawan</div>
    <div class="auth-subtitle">Welcome back</div>

    <form method="post">
        @if (ViewData.ModelState.ErrorCount > 0)
        {
            <div class="auth-error">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@err.ErrorMessage</div>
                }
            </div>
        }

        <div class="form-group">
            <label class="form-label">Email</label>
            <input name="email" type="email" class="form-input" placeholder="you@example.com" required />
        </div>
        <div class="form-group">
            <label class="form-label">Password</label>
            <input name="password" type="password" class="form-input" placeholder="Min. 8 characters" required />
        </div>
        <button type="submit" class="btn btn-primary btn-block">Log in</button>
    </form>

    <div class="auth-link">
        Don't have an account? <a asp-action="Register">Sign up</a>
    </div>
</div>
