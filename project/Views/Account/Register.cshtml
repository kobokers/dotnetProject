@{ Layout = "_AuthLayout"; ViewData["Title"] = "Register"; }

<div class="auth-card">
    <div class="auth-logo">
    <img src="~/icons/logo.png" alt="MehKawan">
    <span>MehKawan</span>
</div>
    <div class="auth-subtitle">Create your account</div>

    <form method="post">
        @if (ViewData.ModelState.ErrorCount > 0)
        {
            <div class="auth-error">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@err.ErrorMessage</div>
                }
            </div>
        }

        <div class="form-group">
            <label class="form-label">Email</label>
            <input name="email" type="email" class="form-input" placeholder="you@example.com" required />
        </div>
        <div class="form-group">
            <label class="form-label">Display Name</label>
            <input name="displayName" class="form-input" placeholder="e.g. John Doe" />
        </div>
        <div class="form-group">
            <label class="form-label">Password</label>
            <input name="password" type="password" class="form-input" placeholder="Min. 8 characters" required />
        </div>
        <button type="submit" class="btn btn-primary btn-block">Sign up</button>
    </form>

    <div class="auth-link">
        Already have an account? <a asp-action="Login">Log in</a>
    </div>
</div>
