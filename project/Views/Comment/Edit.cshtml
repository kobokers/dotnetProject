@model Comment
@{
    ViewData["Title"] = "Edit Comment";
}

<div class="feed-header">
    <h1 class="feed-title">Edit Comment</h1>
</div>

<div class="card">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="All" class="auth-error mb-4"></div>
            <div class="form-group">
                <label asp-for="Content" class="form-label">Content</label>
                <textarea asp-for="Content" class="form-input" rows="3"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
            <div class="flex gap-2">
                <button type="submit" class="btn btn-primary flex-1"><i class="bi bi-check"></i> Save</button>
                <a asp-controller="Post" asp-action="Details" asp-route-id="@Model.PostId" class="btn btn-outline flex-1">Cancel</a>
            </div>
        </form>
    </div>
</div>
