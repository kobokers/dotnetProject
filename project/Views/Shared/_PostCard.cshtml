@model Post
@inject ApplicationDbContext AppDbContext
@inject UserManager<ApplicationUser> UserManager
@using Microsoft.EntityFrameworkCore
@{
    var currentUser = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    var currentUserId = currentUser?.Id;

    var likeCount = await AppDbContext.Likes.CountAsync(l => l.PostId == Model.PostId);
    var commentCount = await AppDbContext.Comments.CountAsync(c => c.PostId == Model.PostId);
    var isLiked = currentUser != null && await AppDbContext.Likes.AnyAsync(l => l.PostId == Model.PostId && l.UserId == currentUser.Id);
    var isBookmarked = currentUser != null && await AppDbContext.Bookmarks
        .AnyAsync(b => b.PostId == Model.PostId && b.UserId == currentUser.Id);
}
<div class="post-card" data-post-id="@Model.PostId">
    <div class="post-card-header">
        @if (!string.IsNullOrEmpty(Model.User.ProfilePhoto))
        {
            <img src="@Model.User.ProfilePhoto" alt="" class="avatar avatar-sm" />
        }
        else
        {
            <div class="avatar-circle avatar-sm" style="font-size:14px;">@(Model.User.DisplayName?[0] ?? '?')</div>
        }
        <div class="post-card-author">
            <a asp-controller="Account" asp-action="Profile" asp-route-id="@Model.UserId">@Model.User.DisplayName</a>
            <div class="post-card-time">@Model.CreatedAt.ToString("MMM dd, yyyy")</div>
        </div>
        @if (Model.UserId == currentUserId)
        {
            <div class="flex gap-2">
                <button type="button" class="btn-icon" title="Edit" onclick="openEditPostModal(@Model.PostId, this)"><i class="bi bi-pencil"></i></button>
                <form method="post" asp-controller="Post" asp-action="Delete" asp-route-id="@Model.PostId" class="d-inline">
                    <button type="submit" class="btn-icon" title="Delete"><i class="bi bi-trash" style="color:var(--danger);"></i></button>
                </form>
            </div>
        }
    </div>

    <div class="post-card-content">@Model.Content</div>

    @if (Model.PostImages.Count > 0)
    {
        var images = Model.PostImages.OrderBy(pi => pi.Order).ToList();
        <div class="post-image-grid" data-count="@images.Count">
            @for (int i = 0; i < images.Count; i++)
            {
                var cls = i == 0 ? "grid-first" : "";
                var isVideo = images[i].ImageUrl.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase) ||
                              images[i].ImageUrl.EndsWith(".webm", StringComparison.OrdinalIgnoreCase) ||
                              images[i].ImageUrl.EndsWith(".ogg", StringComparison.OrdinalIgnoreCase) ||
                              images[i].ImageUrl.EndsWith(".mov", StringComparison.OrdinalIgnoreCase) ||
                              images[i].ImageUrl.EndsWith(".quicktime", StringComparison.OrdinalIgnoreCase) ||
                              images[i].ImageUrl.EndsWith(".avi", StringComparison.OrdinalIgnoreCase) ||
                              images[i].ImageUrl.EndsWith(".mkv", StringComparison.OrdinalIgnoreCase) ||
                              images[i].ImageUrl.EndsWith(".3gp", StringComparison.OrdinalIgnoreCase) ||
                              images[i].ImageUrl.EndsWith(".wmv", StringComparison.OrdinalIgnoreCase);
                <div class="grid-cell @cls" onclick="openLightbox(@Model.PostId, @i)">
                    @if (isVideo)
                    {
                        <video src="@images[i].ImageUrl" muted loop autoplay playsinline style="width:100%;height:100%;object-fit:cover;"></video>
                        <div class="video-grid-overlay" style="position: absolute; top: 8px; right: 8px; background: rgba(0,0,0,0.6); color: #fff; border-radius: 50%; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; pointer-events: none;"><i class="bi bi-play-fill" style="font-size: 16px;"></i></div>
                    }
                    else
                    {
                        <img src="@images[i].ImageUrl" alt="" loading="lazy" />
                    }
                    @if (i == 3 && images.Count > 4)
                    {
                        <div class="grid-overlay">+@(images.Count - 4)</div>
                    }
                </div>
                if (i == 3) break;
            }
        </div>
    }

    <div class="post-card-stats">
        <span><i class="bi bi-heart" style="color:var(--accent);"></i> @likeCount</span>
        <span><i class="bi bi-chat-dots"></i> @commentCount Comments</span>
    </div>

    <div class="post-card-actions">
        @if (currentUser != null)
        {
            <form method="post" asp-controller="Post" asp-action="ToggleLike" asp-route-postId="@Model.PostId" style="flex:1;">
                <button type="submit" class="post-action-btn @(isLiked ? "liked" : "")">
                    <i class="bi @(isLiked ? "bi-heart-fill" : "bi-heart")"></i> Like
                </button>
            </form>
            <button type="button" class="post-action-btn @(isBookmarked ? "bookmarked" : "")"
                    onclick="toggleBookmark(@Model.PostId, this)" aria-label="Bookmark">
                <i class="bi @(isBookmarked ? "bi-bookmark-fill" : "bi-bookmark")"></i>
            </button>
        }
        <button type="button" class="post-action-btn" onclick="openPostModal(@Model.PostId)">
            <i class="bi bi-chat-dots"></i> Comment
        </button>
    </div>
</div>
