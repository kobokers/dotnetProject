@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext AppDbContext
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    ApplicationUser? currentUser = null;
    int notificationCount = 0;

    if (isAuthenticated)
    {
        currentUser = await UserManager.GetUserAsync(User);
        if (currentUser != null)
        {
            if (string.IsNullOrEmpty(currentUser.FriendCode))
            {
                currentUser.FriendCode = currentUser.UserName + "#" + new Random().Next(1000, 9999).ToString();
                await UserManager.UpdateAsync(currentUser);
            }
            currentUser.LastSeen = DateTime.UtcNow;
            await UserManager.UpdateAsync(currentUser);
            notificationCount = await AppDbContext.Notifications
                .CountAsync(n => n.UserId == currentUser.Id && !n.IsRead);
        }
    }
}
<!DOCTYPE html>
<html lang="en" data-theme="oled-dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MehKawan</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/icons/logo.png" type="image/png">
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#1e1f22" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
</head>
<body class="@(isAuthenticated ? "app-authenticated" : "") @ViewBag.BodyClass">
    <div class="app-container">
        @if (isAuthenticated)
        {
            <aside class="sidebar">
<a asp-controller="Post" asp-action="Index" class="sidebar-logo">
    <img src="~/icons/logo.png" alt="MehKawan" style="width: 36px; height: 36px; border-radius: 10px;">
    <span>MehKawan</span>
</a>
                <nav class="sidebar-nav">
                    <a asp-controller="Post" asp-action="Index" class="sidebar-nav-item active-check" data-active="Post,Index">
                        <i class="bi bi-house-fill"></i><span>Home</span>
                    </a>
                    <a asp-controller="Account" asp-action="Search" class="sidebar-nav-item active-check" data-active="Account,Search">
                        <i class="bi bi-search"></i><span>Search</span>
                    </a>
                    <a asp-controller="Notification" asp-action="Index" class="sidebar-nav-item active-check" data-active="Notification,Index">
                        <i class="bi bi-bell"></i><span>Notifications</span>
                        @if (notificationCount > 0)
                        {
                            <span class="notification-badge">@notificationCount</span>
                        }
                    </a>
                    <a asp-controller="Message" asp-action="Index" class="sidebar-nav-item active-check" data-active="Message,Index">
                        <i class="bi bi-chat"></i><span>Messages</span>
                    </a>
                    <a asp-controller="Bookmark" asp-action="Index" class="sidebar-nav-item active-check" data-active="Bookmark,Index">
                        <i class="bi bi-bookmark"></i><span>Bookmarks</span>
                    </a>
                </nav>
                <div class="sidebar-user" id="sidebarUserBtn" onclick="toggleAvatarMenu(event)" style="position:relative;">
                    <div class="sidebar-avatar-wrap">
                        <img src="@(currentUser?.ProfilePhoto != null ? currentUser.ProfilePhoto : "/images/default-avatar.png")" class="avatar avatar-sm" loading="lazy" />
                        <span class="sidebar-online-dot"></span>
                    </div>
                    <div class="sidebar-user-info">
                        <span class="sidebar-username">@(currentUser?.UserName?.Length > 12 ? currentUser.UserName.Substring(0, 12) + "..." : currentUser?.UserName)</span>
                        <span class="friend-code" id="friendCode" onclick="event.stopPropagation();copyFriendCode()" title="Click to copy your Friend Code">@currentUser?.FriendCode</span>
                    </div>
                    <div class="avatar-popup-menu" id="avatarPopupMenu">
                        <a asp-controller="Account" asp-action="Profile" class="avatar-menu-item">
                            <i class="bi bi-person-circle"></i> Profile
                        </a>
                        <a asp-controller="Settings" asp-action="Index" class="avatar-menu-item">
                            <i class="bi bi-gear"></i> Settings
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="avatar-menu-item avatar-menu-item--danger">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </button>
                        </form>
                    </div>
                </div>
            </aside>
        }

        <main class="feed">
            <div class="feed-content">
                @RenderBody()
            </div>
        </main>

        @if (isAuthenticated && ViewData["HideRightPanel"] != (object)true)
        {
            <aside class="right-panel">
                <partial name="_RightPanel" />
            </aside>
        }
        @if (isAuthenticated)
        {
            <nav class="bottom-nav">
                <a asp-controller="Post" asp-action="Index" class="active-check" data-active="Post,Index">
                    <i class="bi bi-house-fill"></i><span>Home</span>
                </a>
                <a asp-controller="Account" asp-action="Search" class="active-check" data-active="Account,Search">
                    <i class="bi bi-search"></i><span>Search</span>
                </a>
                <a href="javascript:void(0)" onclick="openCreatePostModal()">
                    <i class="bi bi-plus-square"></i><span>Create</span>
                </a>
                <a asp-controller="Message" asp-action="Index" class="active-check" data-active="Message,Index">
                    <i class="bi bi-chat"></i><span>Messages</span>
                </a>
                <a asp-controller="Bookmark" asp-action="Index" class="active-check" data-active="Bookmark,Index">
                    <i class="bi bi-bookmark"></i><span>Saved</span>
                </a>
            </nav>
            <a href="javascript:void(0)" onclick="openCreatePostModal()" class="create-fab">
                <i class="bi bi-plus-lg"></i>
            </a>
        }
    </div>

    <!-- Create Post Modal Overlay (Global) -->
    @if (isAuthenticated)
    {
        <div class="post-modal-overlay" id="createPostOverlay">
            <div class="create-post-modal-container">
                <div class="create-post-modal-header">
                    <h3>Create Post</h3>
                    <button type="button" class="post-modal-close" onclick="closeCreatePostModal()" aria-label="Close">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="create-post-modal-body">
                    <form id="createPostForm" method="post" asp-controller="Post" asp-action="Create" enctype="multipart/form-data">
                        <div class="create-post-user">
                            @if (currentUser != null)
                            {
                                if (!string.IsNullOrEmpty(currentUser.ProfilePhoto))
                                {
                                    <img src="@currentUser.ProfilePhoto" alt="" class="avatar avatar-sm" />
                                }
                                else
                                {
                                    <div class="avatar-circle avatar-sm" style="font-size:14px;">@(currentUser.DisplayName?[0] ?? '?')</div>
                                }
                                <span>@currentUser.DisplayName</span>
                            }
                        </div>
                        <textarea name="Content" class="create-post-textarea" placeholder="What's on your mind?" rows="4"></textarea>
                        <div class="create-post-preview" id="createPostPreview"></div>
                        <div class="create-post-footer">
                            <label class="create-post-photo-btn" title="Add photos/videos">
                                <i class="bi bi-image"></i> Add Photos/Videos
                                <input name="images" type="file" accept="image/*,video/*" multiple hidden onchange="previewCreateImages(this)" />
                            </label>
                            <button type="submit" class="btn btn-primary">Post</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <div id="copyToast"></div>

    <!-- Custom Confirm Dialog -->
    <div class="confirm-overlay" id="confirmOverlay">
        <div class="confirm-dialog">
            <div class="confirm-icon"><i class="bi bi-exclamation-triangle"></i></div>
            <div class="confirm-message">Are you sure?</div>
            <div class="confirm-actions">
                <button type="button" class="btn confirm-no">Cancel</button>
                <button type="button" class="btn confirm-yes">Delete</button>
            </div>
        </div>
    </div>

    <script>
        window.toggleAvatarMenu = function(e) {
            e.stopPropagation();
            var menu = document.getElementById('avatarPopupMenu');
            if (!menu) return;
            var isOpen = menu.classList.contains('open');
            if (isOpen) {
                menu.classList.remove('open');
                return;
            }
            var btn = document.getElementById('sidebarUserBtn');
            var r = btn.getBoundingClientRect();
            menu.style.left = Math.max(8, r.left + 10) + 'px';
            menu.style.bottom = (window.innerHeight - r.top + 8) + 'px';
            menu.classList.add('open');
        };

        document.addEventListener('click', function(e) {
            var menu = document.getElementById('avatarPopupMenu');
            if (menu && !e.target.closest('#sidebarUserBtn')) {
                menu.classList.remove('open');
            }
        });

        var confirmCallback = null;

        window.showConfirm = function(message, callback) {
            var overlay = document.getElementById('confirmOverlay');
            if (!overlay) return;
            overlay.querySelector('.confirm-message').textContent = message;
            confirmCallback = callback;
            overlay.classList.add('active');
        };

        function closeConfirm() {
            var overlay = document.getElementById('confirmOverlay');
            if (!overlay) return;
            overlay.classList.remove('active');
            confirmCallback = null;
        }

        document.addEventListener('click', function(e) {
            if (e.target.closest('.confirm-yes')) {
                var cb = confirmCallback;
                closeConfirm();
                if (typeof cb === 'function') cb();
            }
            if (e.target.closest('.confirm-no')) {
                closeConfirm();
            }
            var overlay = document.getElementById('confirmOverlay');
            if (overlay && overlay.classList.contains('active') && e.target === overlay) {
                closeConfirm();
            }
        });

        // ===== Global Create Post Modal =====
        window.openCreatePostModal = function() {
            var overlay = document.getElementById('createPostOverlay');
            if (!overlay) return;
            overlay.classList.add('active');
            document.body.style.overflow = 'hidden';
            var textarea = overlay.querySelector('textarea');
            if (textarea) setTimeout(function() { textarea.focus(); }, 200);
        };

        window.closeCreatePostModal = function() {
            var overlay = document.getElementById('createPostOverlay');
            if (!overlay) return;
            overlay.classList.remove('active');
            document.body.style.overflow = '';
        };

        // Close create post modal on backdrop click
        document.addEventListener('click', function(e) {
            var overlay = document.getElementById('createPostOverlay');
            if (!overlay || !overlay.classList.contains('active')) return;
            if (e.target === overlay) closeCreatePostModal();
        });

        // Create post form submission (AJAX)
        document.addEventListener('submit', function(e) {
            var form = e.target;
            if (!form.id || form.id !== 'createPostForm') return;
            e.preventDefault();

            var submitBtn = form.querySelector('button[type="submit"]');
            var contentInput = form.querySelector('textarea[name="Content"]');
            var fileInput = form.querySelector('input[name="images"]');
            var content = contentInput ? contentInput.value.trim() : '';
            var hasFile = fileInput && fileInput.files && fileInput.files.length > 0;

            if (!content && !hasFile) {
                showToast('Please enter some text or choose an image.');
                return;
            }

            if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Posting...'; }

            fetch(form.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: new FormData(form)
            }).then(function(resp) {
                return resp.json();
            }).then(function(data) {
                if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Post'; }
                if (!data.success) {
                    if (data.error) showToast(data.error);
                    return;
                }

                var feedContent = document.getElementById('feedContent');
                if (feedContent) {
                    var createBox = feedContent.querySelector('.create-post-box');
                    if (createBox) {
                        createBox.insertAdjacentHTML('afterend', data.html);
                    } else {
                        feedContent.insertAdjacentHTML('afterbegin', data.html);
                    }
                    var emptyEl = document.getElementById('feedEmpty');
                    if (emptyEl) emptyEl.style.display = 'none';
                } else {
                    window.location.href = '/Post/Index';
                    return;
                }

                closeCreatePostModal();
                form.reset();
                var preview = document.getElementById('createPostPreview');
                if (preview) preview.innerHTML = '';
            }).catch(function(err) {
                if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Post'; }
                var msg = 'Failed to create post.';
                if (err && err.message) msg = err.message;
                if (err && err.status) msg = 'Server error (' + err.status + ').';
                showToast(msg);
            });
        });

        // Multi-image/video preview for create post
        window.previewCreateImages = function(input) {
            var preview = document.getElementById('createPostPreview');
            if (!preview) return;
            preview.innerHTML = '';
            if (!input.files || input.files.length === 0) return;
            for (var i = 0; i < input.files.length; i++) {
                (function(file) {
                    var url = URL.createObjectURL(file);
                    var wrap = document.createElement('div');
                    wrap.className = 'create-preview-thumb';
                    if (file.type.startsWith('video/')) {
                        wrap.innerHTML = '<video src="' + url + '" muted loop autoplay playsinline style="width:100%;height:100%;object-fit:cover;"></video>' +
                            '<button type="button" class="create-preview-remove" onclick="removeCreateImage(this, \'' + file.name + '\')"><i class="bi bi-x"></i></button>';
                    } else {
                        wrap.innerHTML = '<img src="' + url + '" alt="" style="width:100%;height:100%;object-fit:cover;" />' +
                            '<button type="button" class="create-preview-remove" onclick="removeCreateImage(this, \'' + file.name + '\')"><i class="bi bi-x"></i></button>';
                    }
                    preview.appendChild(wrap);
                })(input.files[i]);
            }
        };

        window.removeCreateImage = function(btn, fileName) {
            var wrap = btn.closest('.create-preview-thumb');
            if (wrap) wrap.remove();
            var input = document.querySelector('#createPostForm input[name="images"]');
            if (!input || !input.files) return;
            var dt = new DataTransfer();
            for (var i = 0; i < input.files.length; i++) {
                if (input.files[i].name !== fileName) {
                    dt.items.add(input.files[i]);
                }
            }
            input.files = dt.files;
        };
    </script>
</body>
</html>
