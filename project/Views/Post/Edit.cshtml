@model Post
@{
    ViewData["Title"] = "Edit Post";
}

<div class="feed-header">
    <h1 class="feed-title">Edit Post</h1>
</div>

<div class="card">
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="auth-error mb-4"></div>
            <div class="form-group">
                <label asp-for="Content" class="form-label">Content</label>
                <textarea asp-for="Content" class="form-input" rows="5" placeholder="What's on your mind?"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <label class="form-label">Image</label>
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="mb-2">
                        <img src="@Model.ImageUrl" alt="" style="max-height:200px;border-radius:var(--radius-md);" />
                    </div>
                }
                <input type="file" name="image" class="form-input" accept="image/*" />
                <small style="color:var(--text-secondary);">Leave empty to keep current image</small>
            </div>
            <div class="flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary flex-1">Save Changes</button>
                <a asp-action="Details" asp-route-id="@Model.PostId" class="btn btn-outline flex-1">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
