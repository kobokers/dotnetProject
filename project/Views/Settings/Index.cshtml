@model ApplicationUser
@{
    ViewData["Title"] = "Settings";
}

<style>
    @@media (max-width: 768px) {
        .feed-content {
            padding-bottom: 100px !important;
        }
    }
</style>

<div class="feed-header">
    <h1 class="feed-title">Settings</h1>
</div>

<div class="settings-section">
    <h3 class="settings-heading">Appearance</h3>
    <p class="settings-sub">Choose your theme</p>
    <div class="theme-grid">
        <label class="theme-card" data-theme-value="oled-dark">
            <input type="radio" name="theme" value="oled-dark" class="theme-radio" />
            <div class="theme-preview" style="background:#1e1f22;border-color:#3f4148;">
                <div class="theme-preview-bar" style="background:#2b2d31;"></div>
                <div class="theme-preview-content">
                    <div class="theme-preview-line" style="background:#5865f2;width:50%;"></div>
                    <div class="theme-preview-line" style="background:#3c3f45;width:80%;"></div>
                    <div class="theme-preview-line" style="background:#3c3f45;width:60%;"></div>
                </div>
            </div>
            <span class="theme-label">OLED Dark</span>
            <span class="theme-desc">Deep dark, easy on the eyes</span>
        </label>
        <label class="theme-card" data-theme-value="teal-dark">
            <input type="radio" name="theme" value="teal-dark" class="theme-radio" />
            <div class="theme-preview" style="background:#1a2b2b;border-color:#2a4a4a;">
                <div class="theme-preview-bar" style="background:#1e3636;"></div>
                <div class="theme-preview-content">
                    <div class="theme-preview-line" style="background:#0891b2;width:50%;"></div>
                    <div class="theme-preview-line" style="background:#2a4a4a;width:80%;"></div>
                    <div class="theme-preview-line" style="background:#2a4a4a;width:60%;"></div>
                </div>
            </div>
            <span class="theme-label">Teal Dark</span>
            <span class="theme-desc">Dark with teal accents</span>
        </label>
        <label class="theme-card" data-theme-value="light">
            <input type="radio" name="theme" value="light" class="theme-radio" />
            <div class="theme-preview" style="background:#ffffff;border-color:#e0e0e0;">
                <div class="theme-preview-bar" style="background:#f5f5f5;"></div>
                <div class="theme-preview-content">
                    <div class="theme-preview-line" style="background:#5865f2;width:50%;"></div>
                    <div class="theme-preview-line" style="background:#e0e0e0;width:80%;"></div>
                    <div class="theme-preview-line" style="background:#e0e0e0;width:60%;"></div>
                </div>
            </div>
            <span class="theme-label">Light</span>
            <span class="theme-desc">Bright and clean</span>
        </label>
    </div>
</div>

@section Scripts {
    <script>
        // Apply saved theme on load
        var saved = localStorage.getItem('mehkawan-theme') || 'oled-dark';
        var activeRadio = document.querySelector('.theme-radio[value="' + saved + '"]');
        if (activeRadio) {
            activeRadio.checked = true;
            activeRadio.closest('.theme-card').classList.add('active');
        } else {
            document.querySelector('.theme-radio[value="oled-dark"]').checked = true;
            document.querySelector('.theme-card[data-theme-value="oled-dark"]').classList.add('active');
        }

        // Theme selection
        document.querySelectorAll('.theme-radio').forEach(function(radio) {
            radio.addEventListener('change', function() {
                if (!this.checked) return;
                document.querySelectorAll('.theme-card').forEach(function(c) {
                    c.classList.remove('active');
                });
                this.closest('.theme-card').classList.add('active');
                var theme = this.value;
                document.documentElement.setAttribute('data-theme', theme);
                localStorage.setItem('mehkawan-theme', theme);
            });
        });
    </script>
}
