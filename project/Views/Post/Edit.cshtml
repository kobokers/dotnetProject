@model Post
@{
    ViewData["Title"] = "Edit Post";
}

<div class="feed-header">
    <h1 class="feed-title">Edit Post</h1>
</div>

<div class="card">
    <div class="card-body">
        <form method="post">
            @if (ViewData.ModelState.ErrorCount > 0)
            {
                <div class="auth-error mb-4">
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@err.ErrorMessage</div>
                    }
                </div>
            }
            <div class="form-group">
                <label class="form-label">Content</label>
                <textarea name="content" class="form-input" rows="5" required>@Model.Content</textarea>
            </div>
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="mb-3">
                    <img src="@Model.ImageUrl" alt="" style="max-height:200px;border-radius:var(--radius-md);" />
                </div>
            }
            <div class="flex gap-2">
                <button type="submit" class="btn btn-primary flex-1">Save Changes</button>
                <a asp-action="Details" asp-route-id="@Model.PostId" class="btn btn-outline flex-1">Cancel</a>
            </div>
        </form>
    </div>
</div>
