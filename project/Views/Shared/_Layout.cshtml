@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext AppDbContext
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    ApplicationUser? currentUser = null;
    int notificationCount = 0;

    if (isAuthenticated)
    {
        currentUser = await UserManager.GetUserAsync(User);
        if (currentUser != null)
        {
            if (string.IsNullOrEmpty(currentUser.FriendCode))
            {
                currentUser.FriendCode = currentUser.UserName + "#" + new Random().Next(1000, 9999).ToString();
                await UserManager.UpdateAsync(currentUser);
            }
            currentUser.LastSeen = DateTime.UtcNow;
            await UserManager.UpdateAsync(currentUser);
            notificationCount = await AppDbContext.Notifications
                .CountAsync(n => n.UserId == currentUser.Id && !n.IsRead);
        }
    }
}
<!DOCTYPE html>
<html lang="en" data-theme="oled-dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MehKawan</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#000000" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
</head>
<body class="@(isAuthenticated ? "app-authenticated" : "") @ViewBag.BodyClass">
    <div class="app-container">
        @if (isAuthenticated)
        {
            <aside class="sidebar">
                <a asp-controller="Post" asp-action="Index" class="sidebar-logo">MehKawan</a>
                <nav class="sidebar-nav">
                    <a asp-controller="Post" asp-action="Index" class="sidebar-nav-item active-check" data-active="Post,Index">
                        <i class="bi bi-house-fill"></i><span>Home</span>
                    </a>
                    <a asp-controller="Account" asp-action="Search" class="sidebar-nav-item active-check" data-active="Account,Search">
                        <i class="bi bi-search"></i><span>Search</span>
                    </a>
                    <a asp-controller="Post" asp-action="Index" class="sidebar-nav-item active-check" data-active="Post,Index">
                        <i class="bi bi-compass"></i><span>Explore</span>
                    </a>
                    <a asp-controller="Notification" asp-action="Index" class="sidebar-nav-item active-check" data-active="Notification,Index">
                        <i class="bi bi-bell"></i><span>Notifications</span>
                        @if (notificationCount > 0)
                        {
                            <span class="notification-badge">@notificationCount</span>
                        }
                    </a>
                    <a asp-controller="Message" asp-action="Index" class="sidebar-nav-item active-check" data-active="Message,Index">
                        <i class="bi bi-chat"></i><span>Messages</span>
                    </a>
                    <a asp-controller="Account" asp-action="Profile" class="sidebar-nav-item active-check" data-active="Account,Profile">
                        <i class="bi bi-person-circle"></i><span>Profile</span>
                    </a>
                    <a asp-controller="Post" asp-action="Create" class="sidebar-create-btn">
                        <i class="bi bi-plus-square"></i><span>Create Post</span>
                    </a>
                </nav>
                <div class="sidebar-user">
                    <img src="@(currentUser?.ProfilePhoto != null ? currentUser.ProfilePhoto : "/images/default-avatar.png")" class="avatar avatar-sm" loading="lazy" />
                    <div class="sidebar-user-info">
                        <span class="sidebar-username">@currentUser?.UserName</span>
                        <span class="friend-code" id="friendCode" onclick="copyFriendCode()" title="Click to copy your Friend Code">@currentUser?.FriendCode</span>
                    </div>
                    <button id="themeBtn" class="btn btn-link p-0" title="Toggle theme" style="color:var(--text-secondary);font-size:18px;margin-right:8px;">
                        <i class="bi bi-moon-stars"></i>
                    </button>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" title="Logout" class="btn btn-link p-0">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                </div>
            </aside>
        }

        <main class="feed">
            <div class="feed-content">
                @RenderBody()
            </div>
        </main>

        @if (isAuthenticated)
        {
            <aside class="right-panel">
                <partial name="_RightPanel" />
            </aside>
            <nav class="bottom-nav">
                <a asp-controller="Post" asp-action="Index" class="active-check" data-active="Post,Index">
                    <i class="bi bi-house-fill"></i><span>Home</span>
                </a>
                <a asp-controller="Account" asp-action="Search" class="active-check" data-active="Account,Search">
                    <i class="bi bi-search"></i><span>Search</span>
                </a>
                <a asp-controller="Post" asp-action="Create">
                    <i class="bi bi-plus-square"></i><span>Create</span>
                </a>
                <a asp-controller="Message" asp-action="Index" class="active-check" data-active="Message,Index">
                    <i class="bi bi-chat"></i><span>Messages</span>
                </a>
                <a asp-controller="Account" asp-action="Profile" class="active-check" data-active="Account,Profile">
                    <i class="bi bi-person-circle"></i><span>Profile</span>
                </a>
            </nav>
            <a asp-controller="Post" asp-action="Create" class="create-fab">
                <i class="bi bi-plus-lg"></i>
            </a>
        }
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <div id="copyToast" style="position:fixed;bottom:24px;right:24px;background:var(--bg-elevated);border:1px solid var(--border-color);border-radius:12px;padding:12px 20px;font-size:13px;color:var(--text-primary);opacity:0;transform:translateY(20px);transition:all 0.3s ease;z-index:9999;pointer-events:none;"></div>
</body>
</html>
