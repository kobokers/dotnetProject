@{
    ViewData["Title"] = "Add Story";
}

<div class="feed-header">
    <h1 class="feed-title">Add Story</h1>
</div>

<div class="card">
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            @if (ViewData.ModelState.ErrorCount > 0)
            {
                <div class="auth-error mb-4">
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@err.ErrorMessage</div>
                    }
                </div>
            }

            <div class="text-center mb-4">
                <div id="preview" style="display:none;margin-bottom:16px;">
                    <img id="previewImg" src="" alt="" style="max-width:100%;max-height:300px;border-radius:var(--radius-md);" />
                </div>
                <div class="file-upload-wrapper" style="justify-content:center;">
                    <label class="file-upload-btn" style="padding:14px 28px;font-size:15px;">
                        <i class="bi bi-camera" style="font-size:20px;"></i> Choose Photo
                        <input name="image" type="file" accept="image/*" hidden required
                               onchange="var f=this.files[0];if(f){var r=new FileReader();r.onload=function(e){document.getElementById('previewImg').src=e.target.result;document.getElementById('preview').style.display='block';};r.readAsDataURL(f);}" />
                    </label>
                </div>
                <p style="font-size:13px;color:var(--text-secondary);margin-top:8px;">Your story will expire in 24 hours</p>
            </div>

            <button type="submit" class="btn btn-primary btn-block"><i class="bi bi-send"></i> Share Story</button>
            <a asp-controller="Post" asp-action="Index" class="btn btn-outline btn-block mt-2">Cancel</a>
        </form>
    </div>
</div>
