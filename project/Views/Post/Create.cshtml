@model Post
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Create Post";
    ViewData["HideRightPanel"] = true;
    var currentUser = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
}

<div class="fb-mobile-post-container">
    <!-- Header -->
    <div class="fb-mobile-header">
        <a href="javascript:history.back()" class="fb-back-btn">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h2 class="fb-header-title">Create Post</h2>
        <button type="submit" form="fbPostForm" id="fbSubmitBtn" class="fb-submit-btn" disabled>Post</button>
    </div>

    <!-- Main Form -->
    <form id="fbPostForm" method="post" enctype="multipart/form-data" asp-controller="Post" asp-action="Create" class="fb-post-form">
        <div asp-validation-summary="All" class="auth-error"></div>
        
        <!-- User Info Row -->
        <div class="fb-user-row">
            @if (currentUser != null)
            {
                if (!string.IsNullOrEmpty(currentUser.ProfilePhoto))
                {
                    <img src="@currentUser.ProfilePhoto" alt="" class="avatar avatar-md" />
                }
                else
                {
                    <div class="avatar-circle avatar-md" style="font-size:16px; width:40px; height:40px;">@(currentUser.DisplayName?[0] ?? '?')</div>
                }
                <div class="fb-user-meta">
                    <span class="fb-username">@currentUser.DisplayName</span>
                    <div class="fb-privacy-badge">
                        <i class="bi bi-globe-americas"></i> Public <i class="bi bi-caret-down-fill"></i>
                    </div>
                </div>
            }
        </div>

        <!-- Textarea -->
        <textarea asp-for="Content" class="fb-textarea" placeholder="What's on your mind?" id="fbTextarea" oninput="validateForm()"></textarea>

        <!-- Media Preview Area -->
        <div class="fb-preview-grid" id="fbPreviewGrid"></div>

        <!-- Add to Post Bar -->
        <div class="fb-add-to-post">
            <span class="fb-add-label">Add to your post</span>
            <div class="fb-add-actions">
                <label class="fb-action-btn fb-action-media" title="Add photos/videos">
                    <i class="bi bi-images" style="color:#45bd62;"></i>
                    <input name="images" id="fbFileInput" type="file" accept="image/*,video/*" multiple hidden onchange="previewMedia(this)" />
                </label>
                <button type="button" class="fb-action-btn" title="Tag friends"><i class="bi bi-person-fill" style="color:#1877f2;"></i></button>
                <button type="button" class="fb-action-btn" title="Feeling/activity"><i class="bi bi-emoji-laughing-fill" style="color:#f7b928;"></i></button>
                <button type="button" class="fb-action-btn" title="Check in"><i class="bi bi-geo-alt-fill" style="color:#f5533d;"></i></button>
            </div>
        </div>
    </form>
</div>

<style>
    .fb-mobile-post-container {
        display: flex;
        flex-direction: column;
        min-height: calc(100vh - 120px);
        background: var(--bg-primary);
        color: var(--text-primary);
    }

    .fb-mobile-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 0px;
        border-bottom: 1px solid var(--border-color);
        background: var(--bg-primary);
        position: sticky;
        top: 0;
        z-index: 100;
    }

    .fb-back-btn {
        color: var(--text-primary);
        font-size: 20px;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        transition: background 0.15s;
    }

    .fb-back-btn:hover {
        background: var(--bg-hover);
    }

    .fb-header-title {
        font-size: 18px;
        font-weight: 600;
        margin: 0;
    }

    .fb-submit-btn {
        background: var(--accent);
        color: #fff;
        border: none;
        padding: 6px 18px;
        font-size: 14px;
        font-weight: 600;
        border-radius: 6px;
        cursor: pointer;
        transition: opacity 0.15s;
    }

    .fb-submit-btn:disabled {
        background: var(--bg-secondary);
        color: var(--text-muted);
        cursor: not-allowed;
        opacity: 0.6;
    }

    .fb-post-form {
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: 16px 0;
        gap: 16px;
    }

    .fb-user-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .fb-user-meta {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .fb-username {
        font-weight: 600;
        font-size: 15px;
    }

    .fb-privacy-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 4px;
        padding: 2px 6px;
        font-size: 11px;
        color: var(--text-secondary);
        font-weight: 600;
        cursor: pointer;
        width: fit-content;
    }

    .fb-textarea {
        width: 100%;
        border: none;
        background: transparent;
        color: var(--text-primary);
        font-size: 18px;
        line-height: 1.5;
        resize: none;
        outline: none;
        min-height: 150px;
        font-family: inherit;
    }

    .fb-textarea::placeholder {
        color: var(--text-muted);
    }

    .fb-preview-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
        gap: 8px;
        margin-top: 8px;
    }

    .fb-preview-thumb {
        position: relative;
        aspect-ratio: 1;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--border-color);
        background: var(--bg-secondary);
    }

    .fb-preview-thumb img,
    .fb-preview-thumb video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .fb-preview-remove {
        position: absolute;
        top: 4px;
        right: 4px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.7);
        color: #fff;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 14px;
        z-index: 5;
    }

    .fb-preview-remove:hover {
        background: rgba(0, 0, 0, 0.9);
    }

    .fb-add-to-post {
        margin-top: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        background: var(--bg-elevated);
    }

    .fb-add-label {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .fb-add-actions {
        display: flex;
        gap: 4px;
    }

    .fb-action-btn {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: none;
        font-size: 18px;
        cursor: pointer;
        transition: background 0.15s;
    }

    .fb-action-btn:hover {
        background: var(--bg-hover);
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function validateForm() {
            var txt = document.getElementById('fbTextarea').value.trim();
            var files = document.getElementById('fbFileInput').files;
            var btn = document.getElementById('fbSubmitBtn');
            if (txt.length > 0 || (files && files.length > 0)) {
                btn.disabled = false;
            } else {
                btn.disabled = true;
            }
        }

        function previewMedia(input) {
            var grid = document.getElementById('fbPreviewGrid');
            grid.innerHTML = '';
            if (!input.files || input.files.length === 0) {
                validateForm();
                return;
            }

            for (var i = 0; i < input.files.length; i++) {
                (function(file) {
                    var url = URL.createObjectURL(file);
                    var wrap = document.createElement('div');
                    wrap.className = 'fb-preview-thumb';
                    
                    if (file.type.startsWith('video/')) {
                        wrap.innerHTML = '<video src="' + url + '" muted loop autoplay playsinline></video>' +
                            '<button type="button" class="fb-preview-remove" onclick="removeMedia(this, \'' + file.name + '\')"><i class="bi bi-x"></i></button>';
                    } else {
                        wrap.innerHTML = '<img src="' + url + '" alt="" />' +
                            '<button type="button" class="fb-preview-remove" onclick="removeMedia(this, \'' + file.name + '\')"><i class="bi bi-x"></i></button>';
                    }
                    grid.appendChild(wrap);
                })(input.files[i]);
            }
            validateForm();
        }

        window.removeMedia = function(btn, fileName) {
            var wrap = btn.closest('.fb-preview-thumb');
            if (wrap) wrap.remove();
            var input = document.getElementById('fbFileInput');
            if (!input || !input.files) return;
            var dt = new DataTransfer();
            for (var i = 0; i < input.files.length; i++) {
                if (input.files[i].name !== fileName) {
                    dt.items.add(input.files[i]);
                }
            }
            input.files = dt.files;
            validateForm();
        };
    </script>
}
