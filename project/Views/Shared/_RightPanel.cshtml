@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext AppDbContext
@using Microsoft.EntityFrameworkCore
@{
    var currentUser = await UserManager.GetUserAsync(User);
    var currentUserId = currentUser?.Id;

    var postCount = currentUserId != null ? await AppDbContext.Posts.CountAsync(p => p.UserId == currentUserId) : 0;
    var friendCount = currentUserId != null ? await AppDbContext.FriendRequests
        .CountAsync(f => (f.SenderId == currentUserId || f.ReceiverId == currentUserId) && f.Status == FriendRequestStatus.Accepted) : 0;
    var likesReceived = currentUserId != null ? await AppDbContext.Likes
        .CountAsync(l => AppDbContext.Posts
            .Where(p => p.UserId == currentUserId)
            .Select(p => p.PostId)
            .Contains(l.PostId)) : 0;

    var friendIds = new List<string>();
    if (currentUser != null)
    {
        friendIds = await AppDbContext.FriendRequests
            .Where(f => f.Status == FriendRequestStatus.Accepted &&
                (f.SenderId == currentUser.Id || f.ReceiverId == currentUser.Id))
            .Select(f => f.SenderId == currentUser.Id ? f.ReceiverId : f.SenderId)
            .ToListAsync();
    }

    var onlineFriends = await UserManager.Users
        .Where(u => friendIds.Contains(u.Id) && u.LastSeen != null && u.LastSeen >= DateTime.UtcNow.AddMinutes(-30))
        .Take(5)
        .ToListAsync();

    var recentActivity = new List<string>();
    if (currentUserId != null)
    {
        var myPostIds = await AppDbContext.Posts
            .Where(p => p.UserId == currentUserId)
            .Select(p => p.PostId)
            .ToListAsync();

        var recentLikes = await AppDbContext.Likes
            .Include(l => l.User)
            .Where(l => myPostIds.Contains(l.PostId))
            .OrderByDescending(l => l.CreatedAt)
            .Take(3)
            .Select(l => l.User.DisplayName + " liked your post")
            .ToListAsync();

        var recentMessages = await AppDbContext.Messages
            .Include(m => m.Sender)
            .Where(m => m.ReceiverId == currentUserId)
            .OrderByDescending(m => m.CreatedAt)
            .Take(2)
            .Select(m => m.Sender.DisplayName + " sent you a message")
            .ToListAsync();

        recentActivity.AddRange(recentLikes);
        recentActivity.AddRange(recentMessages);
    }
}

<div class="right-panel-section">
    <form asp-controller="Account" asp-action="Search" method="get" class="search-wrapper">
        <i class="bi bi-search search-icon"></i>
        <input name="query" class="search-input" type="text" placeholder="Search by name or Friend Code e.g. akmal#1234" />
    </form>
</div>

<div class="right-panel-section">
    <div class="stats-row">
        <div class="stat-item">
            <span class="stat-number">@postCount</span>
            <span class="stat-label">Posts</span>
        </div>
        <div class="stat-item">
            <span class="stat-number">@friendCount</span>
            <span class="stat-label">Friends</span>
        </div>
        <div class="stat-item">
            <span class="stat-number">@likesReceived</span>
            <span class="stat-label">Likes</span>
        </div>
    </div>
</div>

@if (onlineFriends.Any())
{
    <div class="right-panel-section">
        <div class="section-title">Online Friends</div>
        @foreach (var friend in onlineFriends)
        {
            <div class="online-friend">
                <div style="position:relative;display:inline-block;">
                    @if (!string.IsNullOrEmpty(friend.ProfilePhoto))
                    {
                        <img src="@friend.ProfilePhoto" alt="" class="avatar avatar-sm" />
                    }
                    else
                    {
                        <div class="avatar-circle avatar-sm" style="font-size:12px;">@(friend.DisplayName?[0] ?? '?')</div>
                    }
                    <span class="online-dot"></span>
                </div>
                <span class="online-name">@friend.DisplayName</span>
            </div>
        }
    </div>
}

@if (recentActivity.Any())
{
    <div class="right-panel-section">
        <div class="section-title">Recent Activity</div>
        @foreach (var activity in recentActivity)
        {
            <div class="activity-item">
                <i class="bi bi-circle-fill" style="font-size:6px;color:var(--accent);"></i>
                <span>@activity</span>
            </div>
        }
    </div>
}

<div class="right-panel-section">
    <div class="section-title">Trending Topics</div>
    <div>
        <a href="#" class="hashtag-pill">#mehkawan</a>
        <a href="#" class="hashtag-pill">#social</a>
        <a href="#" class="hashtag-pill">#dotnet</a>
        <a href="#" class="hashtag-pill">#coding</a>
        <a href="#" class="hashtag-pill">#community</a>
    </div>
</div>
